---
import '../styles/global.css';
import { SITE, TOPICS, type Topic } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;

const canonical = `${SITE}/${topic.slug}/`;
const breadcrumbId = `${canonical}#breadcrumb`;

const ANCHOR_LABELS: Record<string, string> = {
  'quick-info': 'Quick Info',
  gabay: 'Guide',
  biyahe: 'How to Get There',
  kain: 'Food',
  malapit: 'Nearby',
  faq: 'FAQ',
};

const relatedTopics = topic.related
  .map((slug) => TOPICS.find((x) => x.slug === slug))
  .filter((x): x is Topic => Boolean(x))
  .map((t) => ({ slug: t.slug, t }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: topic.metaTitle,
      description: topic.metaDescription,
      isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website` },
      about: { '@type': 'TouristAttraction', '@id': `${SITE}/#mall` },
      breadcrumb: { '@id': breadcrumbId },
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Divisoria Mall Guide', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: topic.title, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: topic.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{topic.metaTitle}</title>
    <meta name="description" content={topic.metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={topic.metaTitle} />
    <meta property="og:description" content={topic.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Divisoria Mall" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">Divisoria Mall</a>
        <nav class="header-nav">
          <a href="/">Guide (Tagalog)</a>
          <span class="lang-pill">English</span>
        </nav>
      </div>
    </header>

    <main class="subpage">
      <slot />
    </main>

    {
      relatedTopics.length > 0 && (
        <section class="related-guides">
          <div class="container">
            <h2>Related guides</h2>
            <div class="cards">
              {relatedTopics.map((x) => (
                <a class="card" href={`/${x.slug}/`}>
                  <span class="card-title">{x.t.title}</span>
                  <span class="card-text">{x.t.metaDescription}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      topic.homeAnchors && topic.homeAnchors.length > 0 && (
        <section class="hub-links">
          <div class="container">
            <p class="hub-label">More on the main guide:</p>
            <div class="hub-chips">
              {topic.homeAnchors.map((a) => (
                <a class="chip" href={`/#${a}`}>
                  {ANCHOR_LABELS[a] ?? a}
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          <strong>Divisoria Mall</strong> — independent visitor guide. Tabora St, Binondo, Manila.
          Not an official mall site.
        </p>
        <p class="muted">
          Updated {new Date().getFullYear() === 2026 ? 'October 2026' : ''}. Prices, hours and
          stall status change — confirm on the day. Use the <a href="/">main guide</a> for the
          full Tagalog overview.
        </p>
      </div>
    </footer>
  </body>
</html>
